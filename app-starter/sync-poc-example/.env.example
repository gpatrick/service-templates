# Copy to .env and fill in. .env is gitignored; keep it that way.
# Real environment variables override anything set here.

SRC_URL=https://source.example.com
SRC_TOKEN_URL=https://source.example.com/oauth/token
SRC_CLIENT_ID=
SRC_CLIENT_SECRET=

DST_URL=https://dest.example.com
DST_TOKEN_URL=https://dest.example.com/oauth/token
DST_CLIENT_ID=
DST_CLIENT_SECRET=

# Optional; defaults are in settings.py
# SOURCE_PATH=/ledger/entries
# DEST_PATH=/postings
# SOURCE_MAX_ATTEMPTS=4
# DEST_MAX_ATTEMPTS=2
